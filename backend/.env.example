# ── Database ──────────────────────────────────────────────
# SQLite database path (absolute recommended for production)
# DATABASE_URL=sqlite:////var/lib/honeypot/honeypot.db

# ── Cowrie ────────────────────────────────────────────────
# Path to the Cowrie JSON log file
# COWRIE_LOG_PATH=/var/log/cowrie/cowrie.json

# Where Cowrie stores captured files (named by sha256). Required for
# VirusTotal uploads because Cowrie logs file paths relative to its own
# working directory.
# COWRIE_DOWNLOADS_DIR=/opt/cowrie/var/lib/cowrie/downloads

# ── GeoIP ─────────────────────────────────────────────────
# Path to MaxMind GeoLite2-City database (.mmdb)
# Download from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# GEOIP_DB_PATH=/path/to/GeoLite2-City.mmdb

# ── API Keys ──────────────────────────────────────────────
# Admin key (secures /api/admin/* endpoints and SSE stream)
# ADMIN_API_KEY=your-secret-key-here

# VirusTotal API key (optional — enables malware file enrichment)
# VIRUSTOTAL_API_KEY=

# AbuseIPDB API key (optional — enables IP reputation scoring)
# ABUSEIPDB_API_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins (default: localhost dev ports)
# CORS_ORIGINS=https://dashboard.example.com,http://localhost:5173

# ── Runtime ────────────────────────────────────────────────
# IANA timezone used for "today" dashboard windows
# LOCAL_TIMEZONE=America/Los_Angeles

# Start log ingestion/enrichment/reporting workers in the API process
# ENABLE_BACKGROUND_TASKS=true

# ── Splunk HEC ─────────────────────────────────────────────
# Set both to forward live attack events to Splunk
# SPLUNK_HEC_URL=https://splunk.example.com:8088
# SPLUNK_HEC_TOKEN=
# SPLUNK_HEC_VERIFY_SSL=true

# ── Push Alerts ────────────────────────────────────────────
# Set either (or both) to get notified of high-signal events:
# successful logins, captured malware, VT detections, new countries.
# NTFY_URL=https://ntfy.sh/your-secret-topic
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Minimum minutes between repeat alerts for the same IP/file (default 30)
# ALERT_COOLDOWN_MINUTES=30
# VirusTotal engines required to trigger a malware alert (default 3)
# ALERT_VT_MIN_POSITIVES=3

# ── Data Retention ─────────────────────────────────────────
# Days of raw attempts/sessions/page views to keep (0 = keep forever).
# Daily aggregate stats are always kept. Note: IOC exports can only cover
# windows for which raw data still exists.
# RETENTION_DAYS=180

# ── Rate Limiting ─────────────────────────────────────────
# Format: "<count>/<period>" where period is second/minute/hour/day
# RATE_LIMIT_DEFAULT=60/minute
# RATE_LIMIT_STREAM=10/minute

# ── This Hub's Own Sensor ──────────────────────────────────
# Identity of the locally-tailed Cowrie instance. Every event ingested from
# the local log — and all history predating multi-sensor support — is
# attributed to this id, so changing it after deployment splits your history.
# SENSOR_ID=local
# SENSOR_LABEL=Honeypot (Cerritos, CA)
# SENSOR_COUNTRY_CODE=US
# SENSOR_CITY=Cerritos
# SENSOR_PROTOCOLS=ssh
# Published position. Coordinates are rounded on output to the precision
# below, so a home sensor never discloses a street-level location:
#   exact   — as given          city — ~11 km grid       country — ~111 km grid
# SENSOR_LOCATION_PRECISION=exact
# SENSOR_LATITUDE=33.8651
# SENSOR_LONGITUDE=-118.0673

# ── Remote Sensor Ingestion ────────────────────────────────
# Remote sensors push Cowrie events to /api/ingest using a per-sensor token
# minted by POST /api/admin/sensors (see sensor/README.md). Caps below bound
# a single batch:
# INGEST_MAX_EVENTS=500
# INGEST_MAX_BYTES=2000000
# Alert when a sensor's agent stops heartbeating for this long:
# SENSOR_OFFLINE_AFTER_MINUTES=15
# Alert when a sensor agent reports less free disk than this:
# SENSOR_MIN_DISK_FREE_MB=1024
