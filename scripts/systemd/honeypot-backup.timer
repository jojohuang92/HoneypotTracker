[Unit]
Description=Daily snapshot of the honeypot database

[Timer]
OnCalendar=daily
# Spreads the run across the half hour after midnight, well clear of the 03:00
# Sunday malware cleanup.
RandomizedDelaySec=1800
AccuracySec=1min
# A Pi that was powered off at the scheduled time still backs up once it is
# back, rather than silently skipping a day.
Persistent=true

[Install]
WantedBy=timers.target
